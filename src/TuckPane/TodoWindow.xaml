<Window
    x:Class="TuckPane.TodoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        x:Name="WindowFrame"
        BorderThickness="1"
        CornerRadius="8">
        <Grid x:Name="WindowRoot">
            <Grid.Resources>
                <SolidColorBrush x:Key="TodoTextBrush" Color="White" />
                <SolidColorBrush x:Key="TodoInputBrush" Color="#18FFFFFF" />
                <SolidColorBrush x:Key="TodoBorderBrush" Color="White" />
                <SolidColorBrush x:Key="TodoSeparatorBrush" Color="White" Opacity="0.5" />
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="DragTitleBar" Padding="14,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid
                    x:Name="TitleDragSurface"
                    Grid.Column="0"
                    Background="Transparent"
                    SizeChanged="TitleDragSurface_SizeChanged" />
                <TextBlock
                    x:Name="TodoTitleText"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Margin="0,0,48,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="15"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"
                    Tapped="TodoTitleText_Tapped"
                    SizeChanged="TitleDragSurface_SizeChanged" />
                <TextBox
                    x:Name="TodoTitleEditor"
                    Grid.Column="0"
                    MinWidth="100"
                    Margin="-4,3,8,3"
                    Padding="4,0"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    BorderThickness="1"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Visibility="Collapsed"
                    KeyDown="TodoTitleEditor_KeyDown"
                    LostFocus="TodoTitleEditor_LostFocus" />
                <Button
                    x:Name="ColorButton"
                    Grid.Column="1"
                    Width="34"
                    Height="34"
                    Margin="0,0,2,0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="8"
                    Padding="0"
                    Click="ColorButton_Click">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE790;" />
                </Button>
                <ToggleButton
                    x:Name="SeparatorsButton"
                    Grid.Column="2"
                    Width="34"
                    Height="34"
                    Margin="0,0,2,0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="8"
                    Padding="0"
                    Click="SeparatorsButton_Click">
                    <SymbolIcon Symbol="Bullets" />
                </ToggleButton>
                <Button
                    x:Name="CloseButton"
                    Grid.Column="3"
                    Width="34"
                    Height="34"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="8"
                    Padding="0"
                    Click="CloseButton_Click">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE711;" />
                </Button>
            </Grid>

            <TextBox
                x:Name="NewTaskBox"
                Grid.Row="1"
                Margin="16,10,16,10"
                Padding="12,8"
                Background="{StaticResource TodoInputBrush}"
                BorderBrush="{StaticResource TodoBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Foreground="{StaticResource TodoTextBrush}"
                HorizontalContentAlignment="Left"
                KeyDown="NewTaskBox_KeyDown"
                TextAlignment="Left" />

            <ListView
                x:Name="TaskList"
                Grid.Row="2"
                Margin="8,0,8,10"
                Padding="0"
                AllowDrop="True"
                CanDragItems="True"
                CanReorderItems="True"
                DragItemsCompleted="TaskList_DragItemsCompleted"
                ReorderMode="Enabled"
                SelectionMode="None">
                <ListView.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <!-- Keep each brush's color fixed to its dictionary; nested ThemeResource
                                 colors can recolor shared brushes when another themed subtree loads. -->
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked"
                                    Color="#72000000" Opacity="0.5" />
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver"
                                    Color="#72000000" Opacity="0.5" />
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed"
                                    Color="#37000000" Opacity="0.5" />
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled"
                                    Color="#37000000" Opacity="0.5" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Dark">
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked"
                                    Color="#8BFFFFFF" Opacity="0.5" />
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver"
                                    Color="#8BFFFFFF" Opacity="0.5" />
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed"
                                    Color="#28FFFFFF" Opacity="0.5" />
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled"
                                    Color="#28FFFFFF" Opacity="0.5" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast">
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked"
                                    Color="{ThemeResource SystemColorButtonTextColor}" />
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver"
                                    Color="{ThemeResource SystemColorHighlightColor}" />
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed"
                                    Color="{ThemeResource SystemColorHighlightColor}" />
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled"
                                    Color="{ThemeResource SystemColorGrayTextColor}" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,2" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="6,0"
                            Padding="8,8,8,4"
                            BorderBrush="{StaticResource TodoSeparatorBrush}"
                            BorderThickness="{Binding SeparatorThickness}"
                            Opacity="{Binding Opacity}">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="EditTask_Click" Tag="{Binding}" Text="{Binding EditLabel}" />
                                    <MenuFlyoutItem Click="DeleteTask_Click" Tag="{Binding}" Text="{Binding DeleteLabel}" />
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Column="0"
                                    MinWidth="20"
                                    MinHeight="20"
                                    Margin="0,1,8,0"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    Tapped="TaskCheckTarget_Tapped">
                                    <Viewbox
                                        Width="{Binding CheckBoxSize}"
                                        Height="{Binding CheckBoxSize}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform">
                                        <CheckBox
                                            Width="20"
                                            Height="20"
                                            Padding="0"
                                            MinWidth="0"
                                            MinHeight="0"
                                            Click="TaskCheckBox_Click"
                                            DataContextChanged="TaskCheckBox_DataContextChanged"
                                            IsChecked="False"
                                            Tag="{Binding}" />
                                    </Viewbox>
                                </Grid>
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    DoubleTapped="TaskText_DoubleTapped"
                                    FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                                    FontStretch="Normal"
                                    CharacterSpacing="0"
                                    FontSize="{Binding FontSize}"
                                    Foreground="{StaticResource TodoTextBrush}"
                                    Text="{Binding Text}"
                                    TextAlignment="Left"
                                    TextDecorations="{Binding TextDecorations}"
                                    TextWrapping="WrapWholeWords"
                                    Visibility="{Binding TextVisibility}" />
                                <TextBox
                                    Grid.Column="1"
                                    Margin="-4,-5,4,-5"
                                    Padding="4"
                                    AcceptsReturn="False"
                                    Background="{StaticResource TodoInputBrush}"
                                    BorderBrush="{StaticResource TodoBorderBrush}"
                                    FontFamily="Segoe UI Variable Text"
                                    FontSize="{Binding FontSize}"
                                    Foreground="{StaticResource TodoTextBrush}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    KeyDown="TaskEditor_KeyDown"
                                    LostFocus="TaskEditor_LostFocus"
                                    Tag="{Binding}"
                                    Text="{Binding EditText, Mode=TwoWay}"
                                    TextAlignment="Left"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding EditorVisibility}" />
                                <Button
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    Click="UndoTask_Click"
                                    Content="{Binding UndoLabel}"
                                    Tag="{Binding}"
                                    Visibility="{Binding UndoVisibility}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <InfoBar
                x:Name="ErrorBar"
                Grid.Row="1"
                Grid.RowSpan="2"
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />
        </Grid>
    </Border>
</Window>
