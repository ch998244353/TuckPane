<Window
    x:Class="TuckPane.NoteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        x:Name="WindowFrame"
        CornerRadius="8">
        <Grid x:Name="WindowRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="DragTitleBar"
                Padding="14,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid
                    x:Name="TitleDragSurface"
                    Grid.Column="0"
                    Background="Transparent"
                    SizeChanged="TitleDragSurface_SizeChanged" />
                <TextBlock
                    x:Name="NoteTitleText"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Margin="0,0,48,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="15"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"
                    Tapped="NoteTitleText_Tapped"
                    SizeChanged="TitleDragSurface_SizeChanged" />
                <TextBox
                    x:Name="NoteTitleEditor"
                    Grid.Column="0"
                    MinWidth="100"
                    Margin="-4,3,8,3"
                    Padding="4,0"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    BorderThickness="1"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Visibility="Collapsed"
                    KeyDown="NoteTitleEditor_KeyDown"
                    LostFocus="NoteTitleEditor_LostFocus" />
                <Button
                    x:Name="ColorButton"
                    Grid.Column="1"
                    Width="34"
                    Height="34"
                    Margin="0,0,2,0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="8"
                    HorizontalContentAlignment="Center"
                    Padding="0"
                    VerticalContentAlignment="Center"
                    Click="ColorButton_Click">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE790;" />
                </Button>
                <ToggleButton
                    x:Name="RuledLinesButton"
                    Grid.Column="2"
                    Width="34"
                    Height="34"
                    Margin="0,0,2,0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="8"
                    HorizontalContentAlignment="Center"
                    Padding="0"
                    VerticalContentAlignment="Center"
                    Click="RuledLinesButton_Click">
                    <SymbolIcon Symbol="Bullets" />
                </ToggleButton>
                <Button
                    x:Name="CloseButton"
                    Grid.Column="3"
                    Width="34"
                    Height="34"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="8"
                    HorizontalContentAlignment="Center"
                    Padding="0"
                    VerticalContentAlignment="Center"
                    Click="CloseButton_Click">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE711;" />
                </Button>
            </Grid>

            <WebView2
                x:Name="Editor"
                Grid.Row="1" />

            <InfoBar
                x:Name="ErrorBar"
                Grid.Row="1"
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />
        </Grid>
    </Border>
</Window>
