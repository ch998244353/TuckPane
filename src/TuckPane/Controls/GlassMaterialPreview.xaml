<UserControl
    x:Class="TuckPane.Controls.GlassMaterialPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid CornerRadius="5">
        <Image x:Name="Landscape" Source="ms-appx:///Assets/MaterialStudy.png" Stretch="UniformToFill"/>
        <Grid Margin="12,8" CornerRadius="8">
            <Border x:Name="SampleBackdrop" CornerRadius="8"/>
            <Grid x:Name="SurfaceHost" IsHitTestVisible="False"/>
            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox Width="22" Height="18" AutomationProperties.AccessibilityView="Raw">
                    <Canvas Width="26" Height="20">
                        <Path Fill="#FFDD9934" Data="M1,4 Q1,1 4,1 L10,1 L13,4 L22,4 Q25,4 25,7 L25,16 L1,16 Z"/>
                        <Path Fill="#FFFFD574" Data="M1,7 L25,7 L25,16 Q25,19 22,19 L4,19 Q1,19 1,16 Z"/>
                    </Canvas>
                </Viewbox>
                <TextBlock x:Name="SampleLabel" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>
            <Grid x:Name="EdgeHost" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</UserControl>
