<UserControl
    x:Class="TuckPane.Controls.OrganizerPreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="PreviewSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FFF8FAFC" />
            <GradientStop Offset="0.58" Color="#FFE9EFF4" />
            <GradientStop Offset="1" Color="#FFD8E2EA" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PreviewOutlineBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#E8FFFFFF" />
            <GradientStop Offset="0.52" Color="#788FA1B2" />
            <GradientStop Offset="1" Color="#4F627587" />
        </LinearGradientBrush>
    </UserControl.Resources>
    <Grid IsHitTestVisible="False">
        <Border x:Name="ShadowBorder" Margin="1,2,0,0" Background="#24192B3D" CornerRadius="10" />
        <Border
            x:Name="SurfaceBorder"
            Margin="0,0,1,2"
            Padding="4"
            Background="{StaticResource PreviewSurfaceBrush}"
            BorderBrush="{StaticResource PreviewOutlineBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <FontIcon
                    x:Name="EmptyIcon"
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    Foreground="#8C52697A"
                    Glyph="&#xE8B7;"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
                <Image x:Name="Preview0" Margin="2" Stretch="Uniform" />
                <Image x:Name="Preview1" Grid.Column="1" Margin="2" Stretch="Uniform" />
                <Image x:Name="Preview2" Grid.Row="1" Margin="2" Stretch="Uniform" />
                <Image x:Name="Preview3" Grid.Row="1" Grid.Column="1" Margin="2" Stretch="Uniform" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
