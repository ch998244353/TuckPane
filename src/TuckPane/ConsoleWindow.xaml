                            <Border Style="{StaticResource SettingsGroup}" Loaded="SettingsGroup_Loaded" Padding="18">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Name="UpdateVersionText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                    <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                    <TextBlock x:Name="UpdateLastCheckText" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource ConsoleSecondaryTextBrush}"/>
                                    <TextBlock Tag="loc:UpdateDescription" Text="每天自动检查正式版。更新前保存数据并备份配置，完成后重新启动。" TextWrapping="Wrap" Foreground="{StaticResource ConsoleSecondaryTextBrush}"/>
                                    <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="UpdateCheckButton" Tag="loc:UpdateCheck" Content="检查更新" Click="UpdateCheck_Click"/>
                                        <Button x:Name="UpdateInstallButton" Tag="loc:UpdateInstall" Content="更新并重启" Click="UpdateInstall_Click"/>
                                        <Button x:Name="UpdateCancelButton" Tag="loc:UpdateCancel" Content="取消下载" Click="UpdateCancel_Click" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <TextBlock x:Name="UpdateErrorText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Spacing="8">
                                <TextBlock Tag="loc:UpdateReleaseNotes" Text="版本说明" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                <TextBlock x:Name="UpdateNotesText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                <TextBlock x:Name="UpdateRecoveryText" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource ConsoleSecondaryTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="SystemPage" Margin="0,22,0,0" Background="Transparent" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
