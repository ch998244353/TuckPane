            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <SystemBackdropElement x:Name="ConsoleSurfaceHost" Grid.RowSpan="2" IsHitTestVisible="False"/>
        <!-- Only the content is clipped here; the backdrop and edge each
             draw their own rounded outline without a second alpha clip. -->
        <Grid x:Name="ConsoleContentLayer" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Background="{StaticResource ConsoleTitleBarSurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="TitleBarDragRegion" Padding="18,0" Background="Transparent">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                        <Image Width="22" Height="22" Source="ms-appx:///Assets/TuckPane.png"/>
                        <TextBlock x:Name="ConsoleTitleText" FontSize="13" FontWeight="SemiBold" Tag="loc:AppTitle" Text="TuckPane" TextWrapping="Wrap" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                    </StackPanel>
                </Grid>
                <Button x:Name="ConsoleMinimizeButton" Grid.Column="1" Width="46" Height="48" Padding="0" Background="Transparent" BorderThickness="0" Click="ConsoleMinimizeButton_Click" CornerRadius="0" HorizontalContentAlignment="Center" PointerCanceled="ConsoleMinimizeButton_PointerReleased" PointerEntered="ConsoleMinimizeButton_PointerEntered" PointerExited="ConsoleMinimizeButton_PointerExited" PointerPressed="ConsoleMinimizeButton_PointerPressed" PointerReleased="ConsoleMinimizeButton_PointerReleased" VerticalContentAlignment="Center">
                    <FontIcon FontSize="10" Glyph=""/>
                </Button>
                <Button x:Name="ConsoleCloseButton" Grid.Column="2" Width="46" Height="48" Padding="0" Background="Transparent" BorderThickness="0" Click="ConsoleCloseButton_Click" CornerRadius="0" HorizontalContentAlignment="Center" PointerCanceled="ConsoleCloseButton_PointerReleased" PointerEntered="ConsoleCloseButton_PointerEntered" PointerExited="ConsoleCloseButton_PointerExited" PointerPressed="ConsoleCloseButton_PointerPressed" PointerReleased="ConsoleCloseButton_PointerReleased" VerticalContentAlignment="Center">
                    <FontIcon FontSize="12" Glyph=""/>
                </Button>
            </Grid>
            <NavigationView x:Name="RootNavigation" Grid.Row="1" AlwaysShowHeader="False" Background="Transparent" IsBackButtonVisible="Collapsed" IsPaneOpen="True" IsPaneToggleButtonVisible="False" IsSettingsVisible="False" OpenPaneLength="148" PaneDisplayMode="Left" SelectionChanged="RootNavigation_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="SystemNavItem" Height="44" Content="系统" Tag="system">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Setting"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="DisplayNavItem" Height="44" Content="显示" Tag="display">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="View"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="MenuNavItem" Height="44" Content="右键菜单" Tag="menus">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="List"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="InteractionNavItem" Height="44" Content="交互" Tag="interaction">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="TouchPointer"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="ThemeNavItem" Height="44" Content="主题" Tag="theme">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="FontColor"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="ManageNavItem" Height="44" Content="收纳窗" Tag="manage">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Manage"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="StationNavItem" Height="44" Content="中转站" Tag="stations">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Switch"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="DockNavItem" Height="44" Content="Dock 栏" Tag="docks">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="AllApps"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="UpdateNavItem" Height="44" Content="更新" Tag="update">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Download"/></NavigationViewItem.Icon>
                        <NavigationViewItem.InfoBadge><InfoBadge x:Name="UpdateBadge" Value="1" Visibility="Collapsed"/></NavigationViewItem.InfoBadge>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <Grid x:Name="SettingsContentRoot" Padding="18,6,18,18" Background="{StaticResource ConsolePageSurfaceBrush}">
                    <InfoBar x:Name="ConsoleInfoBar" Canvas.ZIndex="5" VerticalAlignment="Top" IsClosable="True" IsOpen="False"/>
                    <ScrollViewer x:Name="UpdatePage" Margin="0,22,0,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="20" MaxWidth="620" HorizontalAlignment="Left" Width="{Binding ViewportWidth, ElementName=UpdatePage}">
