                                                        </ComboBox>
                                                    </Grid>
                                                    <TextBlock Tag="loc:DockIconSizeLabel" Text="图标大小" TextWrapping="Wrap" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="60"/>
                                                        </Grid.ColumnDefinitions>
                                                        <controls:ConsoleSlider x:Name="AddDockIconSizeSlider" Style="{StaticResource Pct}" Minimum="32" Maximum="128" StepFrequency="4" Value="64" ValueChanged="AddControl_Changed"/>
                                                        <TextBlock x:Name="AddDockIconSizeValue" Grid.Column="1" VerticalAlignment="Center" Text="64 DIP" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                                    </Grid>
                                                    <TextBlock Tag="loc:DockSpacingLabel" Text="图标间隔" TextWrapping="Wrap" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="60"/>
                                                        </Grid.ColumnDefinitions>
                                                        <controls:ConsoleSlider x:Name="AddDockSpacingSlider" Style="{StaticResource Pct}" Minimum="0.5" Maximum="2" StepFrequency="0.05" Value="0.75" ValueChanged="AddControl_Changed"/>
                                                        <TextBlock x:Name="AddDockSpacingValue" Grid.Column="1" VerticalAlignment="Center" Text="0.75" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="AddExpansionModeCard" Style="{StaticResource Row}">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="92"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Tag="loc:ExpansionModeLabel" Text="展开行为" TextWrapping="Wrap" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                                    <ComboBox x:Name="AddExpansionModeCombo" Grid.Column="1" Width="190" Height="32" HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="AddControl_Changed">
                                                        <ComboBoxItem Tag="loc:ExpansionModeCollapsible" Content="收缩模式"/>
                                                        <ComboBoxItem Tag="loc:ExpansionModeAlwaysExpanded" Content="展开模式"/>
                                                    </ComboBox>
                                                </Grid>
                                            </Border>
                                            <Border x:Name="AddExpandedContentModeCard" Style="{StaticResource Row}">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="92"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Tag="loc:ExpandedContentModeLabel" Text="内容展开方式" TextWrapping="Wrap" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                                    <ComboBox x:Name="AddExpandedContentModeCombo" Grid.Column="1" Width="190" Height="32" HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="AddControl_Changed">
                                                        <ComboBoxItem Tag="loc:ExpandedContentModeIcon" Content="图标模式"/>
                                                        <ComboBoxItem Tag="loc:ExpandedContentModeCompactList" Content="精简模式"/>
                                                    </ComboBox>
                                                </Grid>
                                            </Border>
                                            <Border x:Name="AddDisplayCard" Style="{StaticResource Row}" Visibility="Collapsed">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="92"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Tag="loc:DisplayLabel" Text="显示器" TextWrapping="Wrap" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                                    <ComboBox x:Name="AddDisplayCombo" Grid.Column="1" Width="270" Height="32" HorizontalAlignment="Right" SelectionChanged="AddControl_Changed"/>
                                                </Grid>
                                            </Border>
                                            <Border x:Name="AddDockEdgeCard" Style="{StaticResource Row}" Visibility="Collapsed">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="92"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Tag="loc:DockEdgeLabel" Text="贴靠边" TextWrapping="Wrap" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                                    <ComboBox x:Name="AddDockEdgeCombo" Grid.Column="1" Width="190" Height="32" HorizontalAlignment="Right" SelectedIndex="2" SelectionChanged="AddControl_Changed">
                                                        <ComboBoxItem Tag="loc:DockLeft" Content="左侧"/>
                                                        <ComboBoxItem Tag="loc:DockTop" Content="顶部"/>
                                                        <ComboBoxItem Tag="loc:DockRight" Content="右侧"/>
                                                        <ComboBoxItem Tag="loc:DockBottom" Content="底部"/>
                                                    </ComboBox>
                                                </Grid>
                                            </Border>
                                            <Border x:Name="AddRowsCard" Style="{StaticResource Row}">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="92"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Tag="loc:RowsLabel" Text="行数" TextWrapping="Wrap" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                                    <controls:ConsoleSlider x:Name="AddRowsSlider" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="2" Maximum="6" StepFrequency="1" Value="3" ValueChanged="AddControl_Changed"/>
                                                </Grid>
                                            </Border>
                                            <Border x:Name="AddColumnsCard" Style="{StaticResource Row}">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="92"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Tag="loc:ColumnsLabel" Text="列数" TextWrapping="Wrap" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                                    <controls:ConsoleSlider x:Name="AddColumnsSlider" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="2" Maximum="6" StepFrequency="1" Value="3" ValueChanged="AddControl_Changed"/>
                                                </Grid>
                                            </Border>
                                            <Border x:Name="AddCompactScaleCard" Style="{StaticResource Row}">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="92"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="48"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Tag="loc:CompactScaleLabel" Text="入口整体" TextWrapping="Wrap" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                                    <controls:ConsoleSlider x:Name="AddCompactScaleSlider" Grid.Column="1" Style="{StaticResource Pct}" Minimum="1.2" Maximum="3" Value="1.56" ValueChanged="AddControl_Changed"/>
                                                    <TextBlock x:Name="AddCompactPercent" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                                </Grid>
                                            </Border>
                                            <Border x:Name="AddCanvasScaleCard" Style="{StaticResource Row}" Visibility="Collapsed">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="92"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="48"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Tag="loc:CanvasScaleLabel" Text="画布大小" TextWrapping="Wrap" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                                    <controls:ConsoleSlider x:Name="AddCanvasScaleSlider" Grid.Column="1" Style="{StaticResource Pct}" Minimum=".1" Maximum="1.2" Value="1" ValueChanged="AddControl_Changed"/>
                                                    <TextBlock x:Name="AddCanvasPercent" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource Row}" Visibility="Collapsed" BorderThickness="0">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="92"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="48"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Tag="loc:ItemScaleLabel" Text="内容比例" TextWrapping="Wrap" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                                    <controls:ConsoleSlider x:Name="AddItemScaleSlider" Grid.Column="1" Style="{StaticResource Pct}" Minimum=".5" Maximum="1.65" Value="1" ValueChanged="AddControl_Changed"/>
                                                    <TextBlock x:Name="AddItemPercent" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Margin="0,6" Spacing="6">
                                        <Button x:Name="CreateOrganizerButton" HorizontalAlignment="Left" MinWidth="100" Click="CreateOrganizerButton_Click" Content="创建" Tag="loc:Create" Style="{StaticResource NeutralActionButtonStyle}"/>
                                        <TextBlock x:Name="CreateLimitText" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </NavigationView>
        </Grid>
        <Grid x:Name="SettingsEdgeOverlay" Grid.RowSpan="2" Background="Transparent" Canvas.ZIndex="100" IsHitTestVisible="False"/>
    </Grid>
</Window>
