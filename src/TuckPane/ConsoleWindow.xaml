                            <TextBlock FontSize="28" FontWeight="SemiBold" Tag="loc:SystemTitle" Text="系统" TextWrapping="Wrap" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                            <Border Style="{StaticResource SettingsGroup}" Loaded="SettingsGroup_Loaded">
                                <Border Style="{StaticResource GeneralRow}" BorderThickness="0">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Tag="loc:DiagnosticsTitle" Text="本地诊断" FontSize="14" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                        <TextBlock Tag="loc:DiagnosticsDescription" Text="导出脱敏运行记录以帮助排查问题。不包含文件正文，不会自动上传。" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                    </StackPanel>
                                    <Button x:Name="ExportDiagnosticsButton" Grid.Column="1" VerticalAlignment="Center" Tag="loc:DiagnosticsExport" Content="导出诊断包" Click="ExportDiagnostics_Click" AutomationProperties.AutomationId="ExportDiagnosticsButton"/>
                                </Grid>
                                </Border>
                            </Border>
                            <Border Style="{StaticResource SettingsGroup}" Loaded="SettingsGroup_Loaded">
                                <StackPanel Spacing="0">
                                    <Border Style="{StaticResource GeneralRow}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="14" Tag="loc:StartupTitle" Text="开机时启动 TuckPane" TextWrapping="Wrap" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                            <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" VerticalAlignment="Center" Toggled="StartupToggle_Toggled"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource GeneralRow}">
                                        <Grid ColumnSpacing="12" RowSpacing="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="14" Tag="loc:FolderMenuTitle" Text="文件夹右键菜单" TextWrapping="Wrap" Foreground="{StaticResource ConsolePrimaryTextBrush}"/>
                                            <ToggleSwitch x:Name="FolderMenuToggle" Grid.Column="1" VerticalAlignment="Center" Toggled="FolderMenuToggle_Toggled"/>
                                            <TextBlock x:Name="FolderMenuStatusText" Grid.Row="1" Grid.ColumnSpan="2" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" Foreground="{StaticResource ConsoleSecondaryTextBrush}"/>
                                            <Button x:Name="FolderMenuRepairButton" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Left" Tag="loc:FolderMenuRepair" Content="修复关联" Click="FolderMenuRepairButton_Click" Visibility="Collapsed" Margin="0,8,0,0"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource GeneralRow}" BorderThickness="0">
                                        <Grid ColumnSpacing="12" RowSpacing="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
