<Window
    x:Class="TuckPane.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TuckPane.Controls">

    <Grid
        x:Name="WindowRoot"
        AllowDrop="True"
        Background="Transparent"
        UseLayoutRounding="True"
        DragEnter="WindowRoot_DragEnter"
        DragLeave="WindowRoot_DragLeave"
        DragOver="WindowRoot_DragOver"
        Drop="WindowRoot_Drop"
        KeyDown="WindowRoot_KeyDown">

        <Grid.Resources>
            <Style x:Key="OrganizerMenuPresenterStyle" TargetType="MenuFlyoutPresenter">
                <Setter Property="HighContrastAdjustment" Value="Auto" />
                <Setter Property="RequestedTheme" Value="Light" />
                <Setter Property="SystemBackdrop" Value="{x:Null}" />
                <Setter Property="Background" Value="#FFFFFFFF" />
            </Style>
            <Style x:Key="OrganizerHideNameMenuStyle" TargetType="ToggleMenuFlyoutItem"
                   BasedOn="{StaticResource DefaultToggleMenuFlyoutItemStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleMenuFlyoutItem">
                            <Grid x:Name="LayoutRoot" Padding="{TemplateBinding Padding}"
                                  Margin="{StaticResource MenuFlyoutItemMargin}"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutItemBackgroundPointerOver}" />
                                                <Setter Target="TextBlock.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundPointerOver}" />
                                                <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundPointerOver}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutItemBackgroundPressed}" />
                                                <Setter Target="TextBlock.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundPressed}" />
                                                <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundPressed}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutItemBackgroundDisabled}" />
                                                <Setter Target="TextBlock.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundDisabled}" />
                                                <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundDisabled}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="CheckGlyph.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="PaddingSizeStates">
                                        <VisualState x:Name="DefaultPadding" />
                                        <VisualState x:Name="NarrowPadding">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Padding" Value="{StaticResource MenuFlyoutItemThemePaddingNarrow}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TextBlock" Text="{TemplateBinding Text}"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextTrimming="{ThemeResource MenuFlyoutItemTextTrimming}"
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <FontIcon x:Name="CheckGlyph" Grid.Column="1" Width="16" Margin="16,0,0,0"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE73E;"
                                          FontSize="12" Foreground="{TemplateBinding Foreground}" Opacity="0"
                                          VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid
            x:Name="CompactView"
            ContextRequested="OrganizerWindow_ContextRequested"
            Width="76"
            Height="68"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid.ContextFlyout>
                <MenuFlyout
                    x:Name="CompactTileContextMenu"
                    Closed="ContextMenu_Closed"
                    MenuFlyoutPresenterStyle="{StaticResource OrganizerMenuPresenterStyle}"
                    Opened="ContextMenu_Opened"
                    Opening="ContextMenu_Opening">
                    <MenuFlyoutSubItem x:Name="CompactAddItemMenuItem" Tag="ContextAddItem" Text="添加项目">
                        <MenuFlyoutItem Click="AddFileMenuItem_Click" Tag="ContextAddFile" Text="文件…" />
                        <MenuFlyoutItem Click="AddFolderMenuItem_Click" Tag="ContextAddFolder" Text="文件夹…" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem x:Name="CompactNewFolderMenuItem" Click="NewFolderMenuItem_Click" Tag="ContextNewFolder" Text="新建文件夹" />
                    <MenuFlyoutItem x:Name="CompactNewNoteMenuItem" Click="NewNoteMenuItem_Click" Tag="ContextNewNote" Text="新建便签" />
                    <MenuFlyoutItem x:Name="CompactNewTodoMenuItem" Click="NewTodoMenuItem_Click" Tag="ContextNewTodo" Text="新建待办" />
                    <MenuFlyoutItem x:Name="CompactPasteMenuItem" Click="PasteMenuItem_Click" IsEnabled="False" Tag="ContextPaste" Text="粘贴" />
                    <MenuFlyoutItem x:Name="CompactDeleteWindowMenuItem" Click="DeleteWindowMenuItem_Click" Tag="ContextDeleteWindow" Text="删除" />
                    <MenuFlyoutItem x:Name="CompactOpenStorageMenuItem" Click="OpenStorageMenuItem_Click" Tag="ContextOpenStorage" Text="打开收纳目录" />
                    <MenuFlyoutItem x:Name="CompactRenameMenuItem" Click="RenameMenuItem_Click" Tag="ContextRename" Text="重命名" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="CompactManageMenuItem" Click="ManageMenuItem_Click" Tag="ContextManage" Text="设置" />
                    <MenuFlyoutItem x:Name="CompactDuplicateMenuItem" Click="DuplicateWindowMenuItem_Click" Tag="ContextDuplicate" Text="窗口复制" />
                    <MenuFlyoutItem x:Name="CompactToggleModeMenuItem" Tag="ContextSwitchPlacement" Click="ToggleModeMenuItem_Click" Text="改为定位" />
                    <MenuFlyoutItem x:Name="CompactToggleContentModeMenuItem" Tag="ContextSwitchContent" Click="ToggleContentModeMenuItem_Click" Text="改为精简" />
                    <MenuFlyoutItem x:Name="CompactToggleExpansionModeMenuItem" Tag="ContextSwitchExpansion" Click="ToggleExpansionModeMenuItem_Click" Text="改为展开" />
                    <ToggleMenuFlyoutItem x:Name="CompactHideNameMenuItem" Tag="ContextHideName" Style="{StaticResource OrganizerHideNameMenuStyle}" Click="HideNameMenuItem_Click" Text="隐藏名称" />
                </MenuFlyout>
            </Grid.ContextFlyout>
            <Grid.RowDefinitions>
                <RowDefinition Height="39" />
                <RowDefinition Height="4" />
                <RowDefinition Height="23" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="CompactTile"
                Grid.Row="0"
                Width="39"
                Height="39"
                HorizontalAlignment="Center"
                Background="Transparent"
                PointerCanceled="CompactTile_PointerCanceled"
                PointerCaptureLost="CompactTile_PointerCaptureLost"
                PointerMoved="CompactTile_PointerMoved"
                PointerPressed="CompactTile_PointerPressed"
                PointerReleased="CompactTile_PointerReleased">
                <Grid
                    x:Name="CompactThumbnailHost"
                    Width="39"
                    Height="39"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <SystemBackdropElement x:Name="CompactSurfaceHost" IsHitTestVisible="False" />
                    <Grid x:Name="CompactIconPresenter">
                        <Grid x:Name="CompactPreviewGrid" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0">
                                <Image x:Name="CompactPreviewImage0" Stretch="Uniform" />
                                <controls:OrganizerPreviewControl x:Name="CompactOrganizerPreview0" Visibility="Collapsed" />
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1">
                                <Image x:Name="CompactPreviewImage1" Stretch="Uniform" />
                                <controls:OrganizerPreviewControl x:Name="CompactOrganizerPreview1" Visibility="Collapsed" />
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="0">
                                <Image x:Name="CompactPreviewImage2" Stretch="Uniform" />
                                <controls:OrganizerPreviewControl x:Name="CompactOrganizerPreview2" Visibility="Collapsed" />
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="1">
                                <Image x:Name="CompactPreviewImage3" Stretch="Uniform" />
                                <controls:OrganizerPreviewControl x:Name="CompactOrganizerPreview3" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Grid>
                    <Grid
                        x:Name="CompactEdgeOverlay"
                        Background="Transparent"
                        Canvas.ZIndex="100"
                        IsHitTestVisible="False" />
                </Grid>
                <Border
                    x:Name="CompactWarningBadge"
                    Width="22"
                    Height="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#B81D232B"
                    CornerRadius="11"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <FontIcon
                        x:Name="CompactWarningIcon"
                        FontSize="14"
                        Foreground="#FFFFC857"
                        Glyph="&#xE814;" />
                </Border>
            </Grid>
            <TextBlock
                x:Name="CompactNameText"
                Grid.Row="2"
                MaxWidth="72"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontFamily="Segoe UI Variable Display"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="White"
                IsTextSelectionEnabled="False"
                Text="文件夹"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid
            x:Name="ExpandedView"
            ContextRequested="OrganizerWindow_ContextRequested"
            Background="Transparent"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Opacity="0"
            UseLayoutRounding="True"
            Visibility="Collapsed">
            <Grid.ContextFlyout>
                <MenuFlyout
                    x:Name="ExpandedViewContextMenu"
                    Closed="ContextMenu_Closed"
                    MenuFlyoutPresenterStyle="{StaticResource OrganizerMenuPresenterStyle}"
                    Opened="ContextMenu_Opened"
                    Opening="ContextMenu_Opening"
                    ShouldConstrainToRootBounds="True">
                    <MenuFlyoutSubItem x:Name="ExpandedAddItemMenuItem" Tag="ContextAddItem" Text="添加项目">
                        <MenuFlyoutItem Click="AddFileMenuItem_Click" Tag="ContextAddFile" Text="文件…" />
                        <MenuFlyoutItem Click="AddFolderMenuItem_Click" Tag="ContextAddFolder" Text="文件夹…" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem x:Name="NewFolderMenuItem" Click="NewFolderMenuItem_Click" Tag="ContextNewFolder" Text="新建文件夹" />
                    <MenuFlyoutItem x:Name="NewNoteMenuItem" Click="NewNoteMenuItem_Click" Tag="ContextNewNote" Text="新建便签" />
                    <MenuFlyoutItem x:Name="NewTodoMenuItem" Click="NewTodoMenuItem_Click" Tag="ContextNewTodo" Text="新建待办" />
                    <MenuFlyoutItem x:Name="PasteMenuItem" Click="PasteMenuItem_Click" IsEnabled="False" Tag="ContextPaste" Text="粘贴" />
                    <MenuFlyoutItem x:Name="ExpandedDeleteWindowMenuItem" Click="DeleteWindowMenuItem_Click" Tag="ContextDeleteWindow" Text="删除" />
                    <MenuFlyoutItem x:Name="ExpandedOpenStorageMenuItem" Click="OpenStorageMenuItem_Click" Tag="ContextOpenStorage" Text="打开收纳目录" />
                    <MenuFlyoutItem x:Name="ExpandedRenameMenuItem" Click="RenameMenuItem_Click" Tag="ContextRename" Text="重命名" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="ExpandedManageMenuItem" Click="ManageMenuItem_Click" Tag="ContextManage" Text="设置" />
                    <MenuFlyoutItem x:Name="ExpandedDuplicateMenuItem" Click="DuplicateWindowMenuItem_Click" Tag="ContextDuplicate" Text="窗口复制" />
                    <MenuFlyoutItem x:Name="ExpandedToggleModeMenuItem" Tag="ContextSwitchPlacement" Click="ToggleModeMenuItem_Click" Text="改为定位" />
                    <MenuFlyoutItem x:Name="ExpandedToggleContentModeMenuItem" Tag="ContextSwitchContent" Click="ToggleContentModeMenuItem_Click" Text="改为精简" />
                    <MenuFlyoutItem x:Name="ExpandedToggleExpansionModeMenuItem" Tag="ContextSwitchExpansion" Click="ToggleExpansionModeMenuItem_Click" Text="改为展开" />
                    <ToggleMenuFlyoutItem x:Name="ExpandedHideNameMenuItem" Tag="ContextHideName" Style="{StaticResource OrganizerHideNameMenuStyle}" Click="HideNameMenuItem_Click" Text="隐藏名称" />
                </MenuFlyout>
            </Grid.ContextFlyout>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ExpandedTitleRow" Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="ExpandedNameText"
                Grid.Row="0"
                Margin="16,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ExpandedOrganizerName"
                FontFamily="Segoe UI Variable Display"
                FontSize="42"
                FontWeight="SemiBold"
                Foreground="White"
                IsHitTestVisible="True"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBox x:Name="ExpandedNameEditor" Grid.Row="0" Margin="16,0"
                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" MinHeight="0"
                TextAlignment="Center" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold"
                Visibility="Collapsed" AutomationProperties.Name="重命名"
                KeyDown="ExpandedNameEditor_KeyDown" LostFocus="ExpandedNameEditor_LostFocus">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="ContentElement"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{TemplateBinding Foreground}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                            IsHorizontalRailEnabled="False" IsVerticalRailEnabled="False"
                            ZoomMode="Disabled" IsTabStop="False"
                            AutomationProperties.AccessibilityView="Raw" />
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
            <Grid x:Name="ExpandedPanel" Grid.Row="1">
                <SystemBackdropElement x:Name="ExpandedSurfaceHost" IsHitTestVisible="False" />
                <Grid x:Name="ExpandedContentLayer" Background="Transparent">
                <Button
                x:Name="CollapseButton"
                Width="28"
                Height="28"
                Margin="0,10,14,0"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                Click="CollapseButton_Click"
                PointerCanceled="CollapseButton_PointerReleased"
                PointerEntered="CollapseButton_PointerEntered"
                PointerExited="CollapseButton_PointerExited"
                PointerPressed="CollapseButton_PointerPressed"
                PointerReleased="CollapseButton_PointerReleased"
                AutomationProperties.Name="收缩"
                Canvas.ZIndex="2">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <Border
                    x:Name="CollapseButtonSurface"
                    Width="28"
                    Height="28"
                    Background="Transparent"
                    CornerRadius="8">
                    <Border
                        x:Name="CollapseDash"
                        Width="12"
                        Height="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="White"
                        CornerRadius="0.5"
                        Opacity="0.78">
                        <Border.ScaleTransition>
                            <Vector3Transition Duration="0:0:0.12" />
                        </Border.ScaleTransition>
                    </Border>
                </Border>
                </Button>
                <ScrollView
                x:Name="ItemsScrollView"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Disabled"
                SizeChanged="ItemsScrollView_SizeChanged"
                VerticalScrollBarVisibility="Hidden"
                VerticalScrollMode="Enabled">
                <ItemsRepeater
                    x:Name="ItemsRepeater"
                    AllowDrop="True"
                    Background="Transparent"
                    Margin="28,40.5,28,28"
                    DragEnter="ItemsGrid_DragEnter"
                    DragLeave="ItemsGrid_DragLeave"
                    DragOver="ItemsGrid_DragOver"
                    Drop="ItemsGrid_Drop"
                    ElementClearing="ItemsRepeater_ElementClearing"
                    ElementPrepared="ItemsRepeater_ElementPrepared">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border
                                x:Name="ItemHost"
                                Background="Transparent"
                                ContextRequested="Item_ContextRequested"
                                CornerRadius="16"
                                DoubleTapped="ItemHost_DoubleTapped"
                                Padding="5"
                                PointerCanceled="Item_PointerCanceled"
                                PointerEntered="Item_PointerEntered"
                                PointerExited="Item_PointerExited"
                                PointerCaptureLost="Item_PointerCaptureLost"
                                PointerMoved="Item_PointerMoved"
                                PointerPressed="Item_PointerPressed"
                                PointerReleased="Item_PointerReleased"
                                Tag="{Binding RelativeName}">
                                <Border.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.12" />
                                </Border.BackgroundTransition>
                                <StackPanel
                                    x:Name="ItemContent"
                                    IsHitTestVisible="False"
                                    HorizontalAlignment="Center"
                                    Tag="{Binding RelativeName}"
                                    VerticalAlignment="Center"
                                    Spacing="6">
                                    <Grid x:Name="ItemIconContainer" Width="72" Height="72">
                                        <FontIcon
                                            x:Name="ItemFallbackIcon"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="42"
                                            Glyph="&#xE7C3;"
                                            Visibility="Collapsed" />
                                        <Image
                                            x:Name="ItemImage"
                                            Width="72"
                                            Height="72"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Stretch="Uniform" />
                                        <controls:OrganizerPreviewControl
                                            x:Name="OrganizerPreview"
                                            IsHitTestVisible="False"
                                            Visibility="Collapsed" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="ItemNameText"
                                        MaxWidth="132"
                                        FontFamily="Segoe UI Variable Text"
                                        FontSize="13"
                                        Foreground="White"
                                        IsHitTestVisible="False"
                                        Text="{Binding Name}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                </ScrollView>
                <Button x:Name="DockEmptyAddButton" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" Padding="0" Click="AddItemMenuItem_Click"
                    AutomationProperties.Name="Add item">
                    <FontIcon x:Name="DockEmptyAddIcon" Glyph="&#xE710;" />
                </Button>
                </Grid>
                <Grid
                    x:Name="ExpandedEdgeOverlay"
                    Background="Transparent"
                    Canvas.ZIndex="100"
                    IsHitTestVisible="False" />
            </Grid>
        </Grid>
    </Grid>
</Window>
